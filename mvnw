#!/bin/sh
PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/$link"
  fi
done
SAVED="`pwd`"
ROOT_DIR=`dirname "$PRG"`
exec "$ROOT_DIR/backend/mvnw" -f "$ROOT_DIR/backend/pom.xml" "$@"
